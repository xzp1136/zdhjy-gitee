// Source: supplied Unity 2022 runtime package; see docs/validation-native-physics-water-2026-11-12.md.
CCEffect %{
 techniques:
 - passes:
   - vert: sprite-vs:vert
     frag: water-fs:frag
     depthStencilState: { depthTest: false, depthWrite: false }
     blendState:
       targets:
       - { blend: true, blendSrc: src_alpha, blendDst: one_minus_src_alpha, blendSrcAlpha: one, blendDstAlpha: one_minus_src_alpha }
     rasterizerState: { cullMode: none }
     properties:
       uvOriginX: { value: [0, 1, 1, 0] }
       uvAxisY: { value: [0, -1, 0, 0] }
       cut: { value: [0.5, 0.004, 0, 0] }
       curve: { value: [-0.05, 0.5, 0.95, 1.5] }
       wave: { value: [0.004, 0.35, 1.8, 0] }
}%
CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%
CCProgram water-fs %{
 precision highp float;
 #include <builtin/uniforms/cc-global>
 #include <builtin/internal/embedded-alpha>
 in vec4 color;
 in vec2 uv0;
 #pragma builtin(local)
 layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
 uniform WaterInputs {
   vec4 uvOriginX;
   vec4 uvAxisY;
   vec4 cut;
   vec4 curve;
   vec4 wave;
 };

  vec2 localUV(vec2 uv) {
    vec2 d=uv-uvOriginX.xy;
    float det=uvOriginX.z*uvAxisY.y-uvOriginX.w*uvAxisY.x;
    return vec2(d.x*uvAxisY.y-d.y*uvAxisY.x, uvOriginX.z*d.y-uvOriginX.w*d.x)/det;
  }
  vec2 sourceUV(vec2 uv) {return uvOriginX.xy+uvOriginX.zw*uv.x+uvAxisY.xy*uv.y;}

 // Exact scalar equation of original SpriteHalfMaskSimple / 1086-1.glsl.
 vec4 frag() {
   vec2 uv=clamp(localUV(uv0),0.0,1.0);
   float x=(uv.x-curve.y)/max(curve.z*0.5,0.0001);
   float curvature=pow(max(1.0-x*x,0.0),max(curve.w,0.0001));
   float waterline=clamp(cut.x+curve.x*curvature+(uv.x-0.5)*cut.z
     +sin((uv.x*wave.z+cc_time.x*wave.y)*6.28318548)*wave.x,0.0,1.0);
   float above=smoothstep(waterline-cut.y,waterline+cut.y,uv.y);
   vec4 o=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0)*color;
   o.a*=cut.w>=0.5?1.0-above:above;
   return o;
 }

}%
